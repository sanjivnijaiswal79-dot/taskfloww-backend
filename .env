# ============================================================
# TaskFlow — Environment Variables
# ============================================================
# IMPORTANT: Never commit this file to git.
# It is already listed in .gitignore.
# Copy this to .env and fill in your actual values.
# ============================================================

# ── Backend ──────────────────────────────────────────────────

# Supabase PostgreSQL connection (Transaction pooler — port 5432)
# SQLAlchemy needs the postgresql+psycopg2:// prefix.
# Replace [YOUR-PASSWORD] with your actual Supabase database password.
# DATABASE_URL="postgresql://postgres.zwwpbjyohczxzlpsmsvu:PGdtJQ9cv3mYNhxk@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
DATABASE_URL=postgresql+psycopg2://postgres.zwwpbjyohczxzlpsmsvu:taskfloww123@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Backend server host and port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ── NLP / AI Parser ──────────────────────────────────────────

# Set to 1 to use a real OpenAI LLM instead of the mock parser
USE_REAL_LLM=0

# Your OpenAI API key (only needed if USE_REAL_LLM=1)
OPENAI_API_KEY=

# ── Frontend ─────────────────────────────────────────────────

# The full URL of the backend API (used in app.js)
VITE_API_URL=http://127.0.0.1:8000